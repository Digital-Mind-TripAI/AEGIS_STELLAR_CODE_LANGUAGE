{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/stellar-stdlib-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "target", "profile", "abi", "pureRelics", "capabilityDescriptors"],
  "properties": {
    "schema": { "const": "stellar.stdlib/v0.1" },
    "name": { "const": "stellar-core" },
    "version": { "type": "string", "pattern": "^0\\.1\\.[0-9]+$" },
    "target": { "const": "windows-x86_64-msvc" },
    "profile": { "const": "stellar-lab-v0" },
    "abi": { "const": "stellar-win64-v0.1" },
    "pureRelics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "interface", "source"],
        "properties": {
          "name": { "enum": ["core.checked", "core.memory", "core.result"] },
          "version": { "type": "string", "pattern": "^0\\.1\\.[0-9]+$" },
          "interface": { "type": "string", "pattern": "^interfaces/[A-Za-z0-9._-]+\\.json$" },
          "source": { "type": "string", "pattern": "^sources/[A-Za-z0-9._-]+\\.asm$" }
        }
      }
    },
    "capabilityDescriptors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "descriptor", "source", "compiled", "authorized"],
        "properties": {
          "name": { "const": "windows.console" },
          "descriptor": { "const": "capabilities/windows.console.relic.json" },
          "source": { "const": "sources/windows.console.asm" },
          "compiled": { "const": false },
          "authorized": { "const": false }
        }
      }
    }
  }
}
