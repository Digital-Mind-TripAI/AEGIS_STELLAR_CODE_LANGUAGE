{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/stellar-capability-relic-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "target", "profile", "abi", "capability", "exports", "allowedImports", "relationContractRequired", "custodianStewardAuthenticationRequired", "osProcessIsolationRequired", "authorized", "compiled", "executionEnabled"],
  "properties": {
    "schema": { "const": "stellar.capability-relic/v0.1" },
    "name": { "const": "windows.console" },
    "version": { "type": "string", "pattern": "^0\\.1\\.[0-9]+$" },
    "target": { "const": "windows-x86_64-msvc" },
    "profile": { "const": "stellar-lab-v0" },
    "abi": { "const": "stellar-win64-v0.1" },
    "capability": { "const": "windows.console.write" },
    "exports": { "type": "array", "minItems": 1, "maxItems": 1 },
    "allowedImports": {
      "const": [{ "dll": "KERNEL32.dll", "symbols": ["WriteFile"] }]
    },
    "relationContractRequired": { "const": true },
    "custodianStewardAuthenticationRequired": { "const": true },
    "osProcessIsolationRequired": { "const": true },
    "authorized": { "const": false },
    "compiled": { "const": false },
    "executionEnabled": { "const": false }
  }
}
