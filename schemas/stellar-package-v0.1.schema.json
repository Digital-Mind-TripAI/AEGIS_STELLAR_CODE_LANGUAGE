{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/stellar-package-v0.1.schema.json",
  "title": "Stellar Windows x64 package v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "target", "profile", "entry", "modules", "relics", "capabilities"],
  "properties": {
    "schema": { "const": "stellar.package/v0.1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "target": { "const": "windows-x86_64-msvc" },
    "profile": { "const": "stellar-lab-v0" },
    "entry": { "type": "string", "minLength": 1 },
    "modules": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "relics": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string" } },
    "capabilities": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string" } }
  }
}
