{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stellar.release-acceptance/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "target", "profile", "nativeCodeExecuted", "executionEnabled", "homeostasis", "gates"],
  "properties": {
    "schema": { "const": "stellar.release-acceptance/v0.1" },
    "status": { "enum": ["pass", "fail"] },
    "target": { "const": "windows-x86_64-msvc" },
    "profile": { "const": "stellar-lab-v0" },
    "nativeCodeExecuted": { "const": false },
    "executionEnabled": { "const": false },
    "homeostasis": { "const": "NOT_EVALUATED" },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed"],
        "properties": { "name": { "type": "string", "minLength": 1 }, "passed": { "type": "boolean" }, "evidence": { "type": "string" } }
      }
    }
  }
}
