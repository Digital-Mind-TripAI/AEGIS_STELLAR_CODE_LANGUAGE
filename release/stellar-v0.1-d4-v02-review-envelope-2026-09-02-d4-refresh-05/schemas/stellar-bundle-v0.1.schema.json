{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/stellar-bundle-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["integrity", "payload"],
  "properties": {
    "integrity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "required": ["schema", "compiler", "target", "profile", "abi", "canonicalManifest", "packageIntegrity", "packageLockHash", "dependencyLockHash", "modules", "relics", "schemas", "provenance", "executionEnabled"],
      "properties": {
        "schema": { "const": "stellar.bundle/v0.1" },
        "target": { "const": "windows-x86_64-msvc" },
        "profile": { "const": "stellar-lab-v0" },
        "abi": { "const": "stellar-win64-v0.1" },
        "modules": { "type": "array", "minItems": 1 },
        "relics": { "type": "array" },
        "schemas": { "type": "array", "minItems": 1 },
        "executionEnabled": { "const": false }
      }
    }
  }
}
