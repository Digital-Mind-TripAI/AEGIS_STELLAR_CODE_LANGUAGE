{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stellar-install-plan-v0.2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceIdentity": { "type": "object", "additionalProperties": false, "required": ["device", "fileId", "bytes", "sha256", "retainedHandle"], "properties": { "device": { "type": "string", "minLength": 1, "maxLength": 128 }, "fileId": { "type": "string", "minLength": 1, "maxLength": 128 }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/hash" }, "retainedHandle": { "const": true } } },
    "serviceState": { "type": "object", "additionalProperties": false, "required": ["name", "state", "binaryPath", "serviceType", "account", "startMode", "delayedAutoStart", "requiredPrivileges", "dependencies", "sidType", "failureActions", "serviceSddl"], "properties": { "name": { "enum": ["AegisStellarCustodian", "AegisStellarExecutionBroker"] }, "state": { "const": "stopped" }, "binaryPath": { "type": "string", "pattern": "^\"[A-Za-z]:\\\\.*\\\\(AegisStellarCustodian|AegisStellarExecutionBroker)\\.exe\"$" }, "serviceType": { "const": "SERVICE_WIN32_OWN_PROCESS" }, "account": { "type": "string", "pattern": "^NT SERVICE\\\\(AegisStellarCustodian|AegisStellarExecutionBroker)$" }, "startMode": { "const": "SERVICE_DEMAND_START" }, "delayedAutoStart": { "const": false }, "requiredPrivileges": { "const": ["SeChangeNotifyPrivilege", "SeImpersonatePrivilege"] }, "dependencies": { "oneOf": [{ "const": [] }, { "const": ["AegisStellarCustodian"] }] }, "sidType": { "const": "SERVICE_SID_TYPE_UNRESTRICTED" }, "failureActions": { "type": "object", "additionalProperties": false, "required": ["resetSeconds", "actions", "failureFlag"], "properties": { "resetSeconds": { "const": 86400 }, "actions": { "const": ["restart/5000", "restart/15000", "none/0"] }, "failureFlag": { "const": true } }, "serviceSddl": { "const": "D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCLCSWRPWPDTLOCRRC;;;BA)" } } }
  },
  "required": ["schema", "mode", "releaseHash", "authorityHashes", "target", "snapshots", "proposed", "unknownResources", "servicesRemainStoppedUntilReadback", "mutationsPerformed", "planHash"],
  "properties": {
    "schema": { "const": "stellar.t7d-install-plan/v0.2" }, "mode": { "const": "ZERO_MUTATION_PROPOSED_STATE" }, "releaseHash": { "$ref": "#/$defs/hash" },
    "authorityHashes": { "type": "array", "minItems": 3, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
    "target": { "type": "object", "additionalProperties": false, "required": ["os", "arch", "installRoot", "dataRoot"], "properties": { "os": { "const": "windows" }, "arch": { "const": "x64" }, "installRoot": { "type": "string", "pattern": "^[A-Za-z]:\\\\" }, "dataRoot": { "type": "string", "pattern": "^[A-Za-z]:\\\\" } } },
    "snapshots": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "observation", "state", "stateHash", "restoration"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 512 }, "kind": { "enum": ["service", "file", "directory", "acl", "key", "certificate", "firewall", "config", "registry", "resource-identity"] }, "observation": { "enum": ["known", "absent", "unknown_requires_elevation", "unknown_not_queried"] }, "state": { "type": ["object", "null"] }, "stateHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "restoration": { "enum": ["restore_exact", "remove_created", "no_change", "unknown_requires_elevation", "unknown_not_queried"] } }, "allOf": [{ "if": { "properties": { "observation": { "const": "known" } } }, "then": { "properties": { "state": { "type": "object" }, "stateHash": { "$ref": "#/$defs/hash" }, "restoration": { "const": "restore_exact" } } } }, { "if": { "properties": { "observation": { "const": "absent" } } }, "then": { "properties": { "state": { "type": "null" }, "stateHash": { "type": "null" }, "restoration": { "const": "remove_created" } } } }, { "if": { "properties": { "observation": { "enum": ["unknown_requires_elevation", "unknown_not_queried"] } } }, "then": { "properties": { "state": { "type": "null" }, "stateHash": { "type": "null" } } } }] } },
    "proposed": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["sequence", "resourceId", "kind", "desired", "desiredState", "desiredStateHash", "requiresElevation", "nativeCommand", "successExitCodes", "readback"], "properties": { "sequence": { "type": "integer", "minimum": 1 }, "resourceId": { "type": "string", "minLength": 1, "maxLength": 512 }, "kind": { "enum": ["service", "file", "directory", "acl", "key", "certificate", "firewall", "config", "registry", "resource-identity"] }, "desired": { "enum": ["present", "absent", "stopped", "configured"] }, "desiredState": { "type": "object" }, "desiredStateHash": { "$ref": "#/$defs/hash" }, "requiresElevation": { "type": "boolean" }, "nativeCommand": { "type": ["string", "null"] }, "successExitCodes": { "const": [0] }, "readback": { "type": "string", "pattern": "^canonical:sha256:[a-f0-9]{64}$" } }, "allOf": [{ "if": { "properties": { "requiresElevation": { "const": true } } }, "then": { "properties": { "nativeCommand": { "type": "string", "pattern": "^native:[a-z-]+:" } } }, "else": { "properties": { "nativeCommand": { "type": "null" } } } }, { "if": { "properties": { "kind": { "const": "file" } } }, "then": { "properties": { "desiredState": { "type": "object", "additionalProperties": false, "required": ["destination", "sourcePath", "sha256", "bytes", "releaseKind", "sourceIdentity"], "properties": { "destination": { "type": "string", "pattern": "^[A-Za-z]:\\\\" }, "sourcePath": { "type": "string", "pattern": "^[^\\\\/:]+(?:/[^\\\\/:]+)*$" }, "sha256": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 0 }, "releaseKind": { "enum": ["service", "broker", "runner", "compiler", "stdlib", "schema", "canonical-policy", "config", "adapter", "script", "documentation", "static-imports"] }, "sourceIdentity": { "$ref": "#/$defs/sourceIdentity" } } } } }, { "if": { "properties": { "kind": { "const": "service" } } }, "then": { "properties": { "desiredState": { "$ref": "#/$defs/serviceState" } } } }] } },
    "unknownResources": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }, "servicesRemainStoppedUntilReadback": { "const": true }, "mutationsPerformed": { "const": 0 }, "planHash": { "$ref": "#/$defs/hash" }
  }
}
